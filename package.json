{
  "name": "mixeo",
  "version": "2.0.0",
  "description": "A video editing and sharing platform.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "install:all": "npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohithVR101/Mixeo.git"
  },
  "author": "Rohith Adithya",
