  "bugs": {
    "url": "https://github.com/rohithVR101/Mixeo/issues"
  },
  "homepage": "https://github.com/rohithVR101/Mixeo#readme",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
